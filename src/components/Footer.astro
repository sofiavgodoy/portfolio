---
import { contact, site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer" id="contact">
  <div class="wrap footer__inner">
    <p class="eyebrow" data-reveal>Contact</p>
    <h2 data-reveal>Let’s make something people actually want to see.</h2>
    <p class="footer__sub" data-reveal>Open to internships and roles in marketing strategy, UX research, and design.</p>
    <ul class="rows">
      {contact.map((c, i) => (
        <li data-reveal style={`--delay:${i * 0.06}s`}>
          <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
            <span>{c.label}</span>
            <span class="rows__value">{c.value}</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="footer__base">
    <span class="footer__name">{site.name}</span>
    <span>© {year} · Designed & built from scratch</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(80px, 12vw, 140px);
    background:
      radial-gradient(60% 50% at 20% 100%, color-mix(in srgb, var(--pink) 22%, transparent), transparent 70%),
      radial-gradient(50% 50% at 85% 90%, color-mix(in srgb, var(--blue) 25%, transparent), transparent 70%),
      radial-gradient(40% 40% at 55% 110%, color-mix(in srgb, var(--lilac) 25%, transparent), transparent 70%);
  }
  .footer__inner { text-align: center; }
  .footer h2 { font-size: clamp(2.1rem, 5.5vw, 3.8rem); max-width: 16ch; margin: 14px auto 0; }
  .footer__sub { color: var(--muted); margin: 14px auto 36px; max-width: 42ch; }
  .rows { list-style: none; padding: 0; margin: 0 auto; max-width: 460px; display: grid; gap: 10px; }
  .rows a {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 20px; border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.7); box-shadow: inset 0 0 0 1px var(--line);
    text-decoration: none; font-size: 15px;
    transition: transform 0.3s var(--ease), box-shadow 0.3s;
  }
  .rows a:hover { transform: translateY(-2px); box-shadow: inset 0 0 0 1px var(--lilac); }
  .rows__value { margin-left: auto; color: var(--muted); }
  .rows svg { width: 14px; height: 14px; color: var(--pink-ink); flex: none; }
  .footer__base {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    padding: 80px 16px 36px; font-size: 13px; color: var(--muted);
  }
  .footer__name { font-family: var(--serif); font-style: italic; font-size: 20px; color: var(--pink-ink); }
</style>
