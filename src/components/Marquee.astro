---
interface Props { items: { src: string; href: string; alt: string }[] }
const { items } = Astro.props;
---
<div class="marquee" aria-label="A sneak peek of my work">
  <ul class="marquee__track">
    {[...items, ...items].map((it, i) => (
      <li aria-hidden={i >= items.length ? 'true' : undefined}>
        <a href={it.href} tabindex={i >= items.length ? -1 : undefined}>
          <img src={it.src} alt={i >= items.length ? '' : it.alt} loading="lazy" decoding="async" />
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track {
    display: flex; gap: 18px; width: max-content; list-style: none; margin: 0; padding: 12px 0;
    animation: scroll 60s linear infinite;
  }
  .marquee:hover .marquee__track, .marquee:focus-within .marquee__track { animation-play-state: paused; }
  .marquee li:nth-child(odd) { translate: 0 10px; }
  .marquee a { display: block; border-radius: 16px; overflow: hidden; transition: scale 0.5s var(--ease); }
  .marquee a:hover { scale: 1.04; }
  .marquee img { height: clamp(170px, 22vw, 250px); width: auto; aspect-ratio: 4 / 3; object-fit: cover; background: var(--surface); }
  @keyframes scroll { to { transform: translateX(calc(-50% - 9px)); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee { overflow-x: auto; }
  }
</style>
