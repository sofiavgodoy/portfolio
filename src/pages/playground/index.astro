---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const play = (await getCollection('playground', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);

// Every piece gets a slightly different treatment, like a real scrapbook page.
const tapes = ['var(--pink)', 'var(--blue)', 'var(--lilac)'];
const tilts = [-2.2, 1.6, -0.8, 2.4, -1.4, 0.9];
const styles = ['polaroid', 'taped', 'polaroid', 'taped', 'taped', 'polaroid'];

// Sticky notes slotted between pieces (index → note).
const notes: Record<number, { text: string; c: string }> = {
  2: { text: 'art, games, animation & photos ✿', c: 'var(--pink)' },
  6: { text: 'tap anything to open it!', c: 'var(--blue)' },
  10: { text: 'more pages coming soon…', c: 'var(--lilac)' },
};
---
<Base title="Playground" description="Illustration, animation, games, and photography by Sofia Godoy.">
  <section class="wrap page-head">
    <p class="eyebrow" data-reveal>Playground</p>
    <h1 data-reveal>Things I make for fun</h1>
    <p data-reveal>Illustration, animation, games, and photography: the side of me that keeps the strategy human.</p>
  </section>

  <section class="wrap">
    <div class="journal">
      <div class="journal__rings" aria-hidden="true"></div>

      <header class="journal__head">
        <p class="journal__title">Sofia’s scrapbook</p>
        <p class="journal__stamp">est. 2026 · vol. 1</p>
      </header>

      <svg class="sticker s1" viewBox="0 0 40 40" aria-hidden="true"><g fill="var(--pink)">{[0, 72, 144, 216, 288].map((r) => <ellipse cx="20" cy="10" rx="6.5" ry="9" transform={`rotate(${r} 20 20)`} />)}</g><circle cx="20" cy="20" r="5" fill="#ffd77a" /></svg>
      <svg class="sticker s2" viewBox="0 0 40 40" aria-hidden="true"><path fill="var(--blue)" d="M20 3l4.9 10.6 11.6 1.3-8.6 7.9 2.4 11.4L20 28.4 9.7 34.2l2.4-11.4-8.6-7.9 11.6-1.3z" /></svg>
      <svg class="sticker s3" viewBox="0 0 40 40" aria-hidden="true"><path fill="var(--lilac)" d="M20 35S5 25.5 5 15a8 8 0 0 1 15-3.9A8 8 0 0 1 35 15c0 10.5-15 20-15 20z" /></svg>

      <ul class="board">
        {play.map((p, i) => (
          <>
            {notes[i] && (
              <li class="note" style={`--c:${notes[i].c}; --r:${tilts[(i + 3) % tilts.length]}deg`} aria-hidden="true">
                {notes[i].text}
              </li>
            )}
            <li
              class={`piece piece--${styles[i % styles.length]}`}
              data-reveal
              style={`--delay:${(i % 3) * 0.06}s; --r:${tilts[i % tilts.length]}deg; --tc:${tapes[i % tapes.length]}; --tr:${i % 2 ? 5 : -4}deg`}
            >
              <a href={`/playground/${p.id}`}>
                <span class="tape"></span>
                <img src={p.data.cover} alt="" loading="lazy" decoding="async" />
                <span class="piece__title">{p.data.title}</span>
                <span class="ticket">{p.data.kind}</span>
              </a>
            </li>
          </>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .journal {
    position: relative; margin-bottom: 40px;
    padding: clamp(56px, 7vw, 80px) clamp(16px, 4vw, 48px) clamp(32px, 5vw, 56px);
    border-radius: 18px;
    background:
      linear-gradient(90deg, transparent 0 calc(clamp(16px, 4vw, 48px) - 14px), color-mix(in srgb, var(--pink) 45%, transparent) 0 calc(clamp(16px, 4vw, 48px) - 13px), transparent 0),
      repeating-linear-gradient(transparent 0 33px, #e8e4f2 33px 34px),
      #fffdf9;
    box-shadow: 0 30px 60px -40px rgb(20 26 77 / 0.35), inset 0 0 0 1px var(--line);
  }
  /* Spiral binding holes along the top, like my notebook */
  .journal__rings {
    position: absolute; left: 24px; right: 24px; top: 16px; height: 16px;
    background: radial-gradient(circle at 8px 8px, var(--surface-2) 0 6px, rgb(20 26 77 / 0.15) 6px 7px, transparent 7.5px) 0 0 / 34px 16px repeat-x;
  }
  .journal__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; margin-bottom: 26px; }
  .journal__title { margin: 0; font-family: var(--hand); font-weight: 600; font-size: clamp(2rem, 5vw, 2.8rem); color: var(--navy); line-height: 1; }
  .journal__stamp {
    margin: 0; padding: 4px 12px; border: 1.5px dashed var(--pink-ink); border-radius: 6px; rotate: 3deg;
    font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--pink-ink);
  }

  .sticker { position: absolute; width: 44px; z-index: 3; filter: drop-shadow(0 2px 2px rgb(20 26 77 / 0.15)); }
  .sticker.s1 { right: 6%; top: 46px; rotate: 12deg; }
  .sticker.s2 { left: -10px; top: 38%; width: 34px; rotate: -14deg; }
  .sticker.s3 { right: -8px; bottom: 18%; width: 38px; rotate: 10deg; }

  .board { list-style: none; padding: 0; margin: 0; columns: 3 250px; column-gap: 26px; }
  .board > li { break-inside: avoid; margin-bottom: 16px; padding-top: 14px; }

  .piece a {
    position: relative; display: block; text-decoration: none;
    rotate: var(--r); transition: rotate 0.5s var(--ease), transform 0.5s var(--ease), box-shadow 0.5s;
  }
  .piece a:hover, .piece a:focus-visible { rotate: 0deg; transform: translateY(-5px); }
  .piece img { width: 100%; background: var(--surface); }

  .piece--polaroid a { background: #fff; padding: 10px 10px 14px; box-shadow: 0 14px 30px -18px rgb(20 26 77 / 0.45); }
  .piece--taped a { padding-top: 6px; }
  .piece--taped img { border-radius: 4px; box-shadow: 0 14px 30px -18px rgb(20 26 77 / 0.5); }

  .piece__title { display: block; margin: 10px 4px 0; font-family: var(--hand); font-weight: 600; font-size: 1.6rem; line-height: 1.05; color: var(--navy); }
  .ticket {
    display: inline-block; margin: 8px 4px 0; padding: 3px 12px;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--navy);
    background:
      radial-gradient(circle at 0 50%, transparent 5px, color-mix(in srgb, var(--tc) 40%, #fff) 5.5px) left / 51% 100% no-repeat,
      radial-gradient(circle at 100% 50%, transparent 5px, color-mix(in srgb, var(--tc) 40%, #fff) 5.5px) right / 51% 100% no-repeat;
  }

  .note {
    padding: 18px 18px 22px; rotate: var(--r);
    background: color-mix(in srgb, var(--c) 32%, #fffbe8);
    font-family: var(--hand); font-size: 1.55rem; line-height: 1.15; color: var(--navy);
    box-shadow: 0 10px 18px -12px rgb(20 26 77 / 0.35);
    clip-path: polygon(0 0, 100% 0, 100% 86%, 90% 100%, 0 100%);
  }
</style>
