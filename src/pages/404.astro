---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap page-head" style="min-height: 50vh">
    <p class="eyebrow">404</p>
    <h1>This page wandered off</h1>
    <p>Let’s get you back to the <a href={u('/')}>homepage</a> or my <a href={u('/work')}>work</a>.</p>
  </section>
</Base>
